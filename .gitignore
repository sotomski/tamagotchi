# OS noise
.DS_Store
Thumbs.db

# Editor scratch
*.swp
*.swo
.idea/
.vscode/*.local.json
.claude/settings.local.json

# Logs
*.log

# Node (for any tooling layered later)
node_modules/

# Local env
.env
.env.local

# Dart / pub (workspace)
.dart_tool/
.packages
pubspec_overrides.yaml

# scloud deployment generated files should not be committed to git
**/.scloud/

# Lefthook
lefthook-local.yml

# Agent skills — treat like `pub get`: commit the manifest, not the fetched skills.
#   Fetch with: `skills get --ide claude` (manifest: .dart_skills/skills_config.json)
# Ignore every fetched skill dir under .claude/skills/ (incl. 10x-*, see below).
/.claude/skills/*/
# Dart skills CLI registry clone cache (regenerated on `skills get`).
/.dart_skills/repos/
# 10xDevs course content (paid, login-gated) — fetched locally via `npx @przeprogramowani/10x-cli get <lesson>`, never committed.
/.claude/prompts/
/.claude/.10x-cli-manifest.json
# Per-session scheduler lock — machine/session-local runtime state, not source.
/.claude/scheduled_tasks.lock
